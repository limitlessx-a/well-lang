module demo.lib.httpparser;

/* Reusable pure-Well HTTP/1.1 request parser (see 65_well_http_parser).
   Allocation-lean: request line / headers are sliced with byte offsets instead
   of materializing an intermediate String per header line. */

struct ParsedReq {
    ok: bool;
    method: String;
    target: String;
    path: String;
    query: String;
    version: String;
    headers: Map<String>;
    headerCount: int;
    body: String;
}

func parseUnsigned(s: String): int {
    var n: int = s.length;
    if (n == 0) {
        return -1;
    }
    var v: int = 0;
    for (var i: int = 0; i < n; i = i + 1) {
        var c: int = s[i];
        if (c < 48 || c > 57) {
            return -1;
        }
        v = v * 10 + (c - 48);
    }
    return v;
}

func parseRequest(raw: String): ParsedReq {
    var r: ParsedReq = new ParsedReq();
    r.ok = false;
    r.headers = new Map<String>();
    r.headerCount = 0;
    r.query = "";
    r.body = "";

    var pos: int = 0;
    var lineEnd: int = raw.indexOf("\r\n", pos);
    if (lineEnd < 0) {
        return r;
    }
    var sp1: int = raw.indexOf(" ", pos);
    if (sp1 <= pos || sp1 > lineEnd) {
        return r;
    }
    var sp2: int = raw.indexOf(" ", sp1 + 1);
    if (sp2 <= sp1 + 1 || sp2 > lineEnd) {
        return r;
    }
    r.method = raw.substring(pos, sp1);
    var target: String = raw.substring(sp1 + 1, sp2);
    r.target = target;
    r.version = raw.substring(sp2 + 1, lineEnd);
    pos = lineEnd + 2;

    var qm: int = target.indexOf("?");
    if (qm >= 0) {
        r.path = target.substring(0, qm);
        r.query = target.substring(qm + 1, target.length);
    } else {
        r.path = target;
    }

    var contentLength: int = -1;
    while (true) {
        lineEnd = raw.indexOf("\r\n", pos);
        if (lineEnd < 0) {
            return r;
        }
        if (lineEnd == pos) {
            pos = lineEnd + 2;
            break;
        }
        var colon: int = raw.indexOf(":", pos);
        if (colon <= pos || colon > lineEnd) {
            return r;
        }
        var name: String = raw.substring(pos, colon).toLower();
        var value: String = raw.substring(colon + 1, lineEnd).trim();
        r.headers.set(name, value);
        r.headerCount = r.headerCount + 1;
        if (name == "content-length") {
            contentLength = parseUnsigned(value);
        }
        pos = lineEnd + 2;
    }
    if (contentLength < 0) {
        contentLength = 0;
    }
    if (contentLength > raw.length - pos) {
        return r;
    }
    r.body = raw.substring(pos, pos + contentLength);
    r.ok = true;
    return r;
}
