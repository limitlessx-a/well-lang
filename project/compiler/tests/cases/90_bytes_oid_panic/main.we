module demo.bytesoid;

static Cfg {
    buf: Bytes;
}

event GoEvent extends Event {
    n: int;
}

controller MainController {
    run() {
        Cfg.buf = new Bytes();
        on(GoEvent, GoHandler);
        emit(new GoEvent(1) { n: 1 });
        emit(new GoEvent(1) { n: 2 });
    }
}

handler GoHandler {
    onEvent(e: GoEvent) {
        if (e.n == 1) {
            Cfg.buf.appendStr("x");
        } else {
            Cfg.buf.push(65);
        }
        print("should not print");
    }
}

entry MainController;