module demo.workers;

event PingEvent extends Event {
    n: int;
}

controller MainController {
    run() {
        on(PingEvent, PingHandler);
        for (var i: int = 1; i <= 20; i = i + 1) {
            emit(new PingEvent(1) { n: i });
        }
    }
}

handler PingHandler {
    onEvent(e: PingEvent) {
        print(e.n);
    }
}

entry MainController;
