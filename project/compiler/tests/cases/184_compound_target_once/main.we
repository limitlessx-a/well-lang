module demo.compoundonce;

static State {
    calls: int = 0;
}

struct ItemVo extends Vo {
    register: int;
    name: String;
}

// Returns 0 and counts calls: `arr[idx()] += 1` must call idx() exactly once.
func idx(): int {
    State.calls = State.calls + 1;
    return 0;
}

controller Main {
    run() {
        var arr: Array<int> = [10, 20];
        arr[idx()] += 5;
        print("calls", State.calls, "value", arr[0]);

        var d: ItemVo = new ItemVo();
        d.register = 1;
        d.register += 2;
        d.name = "a";
        d.name += "b";
        print(d.register, d.name);

        var names: Array<String> = ["x"];
        names[idx()] += "!";
        print(names[0], State.calls);
    }
}

entry Main;
