module demo.ws;

event WsOpenEvent extends Event {
    clientId: long;
    path: String;
    query: String;
}

event WsMessageEvent extends Event {
    clientId: long;
    text: String;
}

event WsCloseEvent extends Event {
    clientId: long;
    code: int;
    reason: String;
}

controller WsController {
    run() {
        Ws.route("/chat", WsOpenHandler, WsMessageHandler, WsCloseHandler);
        Ws.listen(18082);
    }
}

handler WsOpenHandler {
    onEvent(e: WsOpenEvent) {
        Ws.send(e.clientId, "welcome");
    }
}

handler WsMessageHandler {
    onEvent(e: WsMessageEvent) {
        Ws.send(e.clientId, e.text);
        Ws.close(e.clientId, 1000, "bye");
        Ws.stop();
    }
}

handler WsCloseHandler {
    onEvent(e: WsCloseEvent) {
        print("closed ", e.code);
    }
}

entry WsController;
