module demo.fe_switch_string_enum;

enum Color {
    RED = "red";
    BLUE = "blue";
}

controller Main {
    run() {
        var c = Color.RED;
        switch (c) {
            case Color.RED: print("r");
            case Color.BLUE: print("b");
        }
        var d = Color.BLUE;
        switch (d) {
            case Color.RED: print("r");
            case Color.BLUE: print("b");
        }
        print("ok");
    }
}

entry Main;
