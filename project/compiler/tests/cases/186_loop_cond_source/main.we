module demo.loopcond;

event GoEvent extends Event {
    n: int;
}

controller Main {
    run() {
        on(GoEvent, GoHandler);
        emit(new GoEvent(1) { n: 1 });
        print("after");
    }
}

handler GoHandler {
    onEvent(e: GoEvent) {
        var i: int = 1;
        var j: int = 1;
        while (i / j > 0) {
            j = 0;
            i = i + 1;
        }
        print("never");
    }
}

entry Main;
