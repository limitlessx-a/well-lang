module demo.eventimmutable;

event PingEvent extends Event {
    n: int;
}

controller MainController {
    run() {
        on(PingEvent, Handler);
        emit(new PingEvent(1) { n: 1 });
    }
}

handler Handler {
    onEvent(e: PingEvent) {
        print("before:", e.n);
        e.n = 2;
        print("should not reach here");
    }
}

entry MainController;
