module demo.jsonpretty;

struct Inner {
    x: int;
}

struct Item {
    a: int;
    inner: Inner;
    arr: Array<int>;
    m: Map<int>;
}

controller MainController {
    run() {
        var item: Item = new Item();
        item.a = 1;
        var inner: Inner = new Inner();
        inner.x = 7;
        item.inner = inner;
        var arr: Array<int> = [1, 2];
        item.arr = arr;
        var m: Map<int> = {"k": 9};
        item.m = m;
        print(Json.stringify(item, 2));
        print(Json.stringify(item));
        print(Json.stringify(item, 0));
    }
}

entry MainController;