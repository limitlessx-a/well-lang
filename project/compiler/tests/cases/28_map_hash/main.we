module demo.maphash;

controller MainController extends Controller {
    run() {
        var keys: Array<String> = [
            "k0", "k1", "k2", "k3", "k4",
            "k5", "k6", "k7", "k8", "k9",
            "k10", "k11", "k12", "k13", "k14",
            "k15", "k16", "k17", "k18", "k19"
        ];

        var m: Map<int> = {};
        for (var i: int = 0; i < keys.length; i = i + 1) {
            m.set(keys[i], i);
        }
        print("size ", m.size);
        print("k0 ", m.get("k0"));
        print("k19 ", m.get("k19"));

        m.delete("k5");
        m.delete("k10");
        print("size2 ", m.size);

        var n: int = 0;
        for (var k in m) {
            n = n + 1;
        }
        print("count ", n);
        print("k6 ", m.get("k6"));
        print("k10 ", m.get("k10"));
    }
}

entry MainController;
