module demo.evsubinherit;

event BasePingEvent {
    n: int;
}

event PingEvent extends BasePingEvent {
    msg: String;
}

handler PingHandler {
    onEvent(e: BasePingEvent) {
        print("base field ", e.n);
    }
}

controller MainController {
    run() {
        on(PingEvent, PingHandler);
        emit(new PingEvent(0) { n: 7, msg: "derived" });
    }
}

entry MainController;