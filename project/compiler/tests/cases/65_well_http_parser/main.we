module demo.wellhttp;

/* Pure-Well HTTP/1.1 request parser, imported from examples/lib. */

import "../../../examples/lib/http_parser";

func show(r: ParsedReq): void {
    if (!r.ok) {
        print("bad");
        return;
    }
    print("ok ", r.ok);
    print("method ", r.method);
    print("path ", r.path);
    print("query ", r.query);
    print("version ", r.version);
    print("headers ", r.headerCount);
    print("body ", r.body);
    print("len ", r.body.length);
}

controller MainController {
    run() {
        var raw1: String = "GET /index.html?a=1&b=2 HTTP/1.1\r\nHost: example.com\r\nUser-Agent: well\r\nContent-Type: text/plain\r\nContent-Length: 11\r\n\r\nhello world";
        var r1: ParsedReq = parseRequest(raw1);
        show(r1);
        print("host ", r1.headers.get("host"));
        print("ua ", r1.headers.get("user-agent"));
        var raw2: String = "POST /api HTTP/1.0\r\nContent-Length: 0\r\n\r\n";
        var r2: ParsedReq = parseRequest(raw2);
        show(r2);
        print("host2 ", r2.headers.get("host"));
        var raw3: String = "GET /x\r\n\r\n";
        var r3: ParsedReq = parseRequest(raw3);
        show(r3);
        var raw4: String = "PUT /data?x=9 HTTP/1.1\r\nCONTENT-LENGTH: 3\r\n\r\nabc";
        var r4: ParsedReq = parseRequest(raw4);
        show(r4);
        print("x ", r4.query);
    }
}

entry MainController;