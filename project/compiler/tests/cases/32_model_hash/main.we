module demo.modelhash;

event PingEvent extends Event {
    n: int;
}

struct ItemVo extends Vo {
    n: int;
}

controller MainController extends Controller {
    run() {
        on(PingEvent, PingHandler);

        for (var i: int = 0; i < 1000; i = i + 1) {
            emit(new PingEvent(i + 1) { n: i + 1 });
        }
        for (var i: int = 0; i < 1000; i = i + 1) {
            emit(new PingEvent(i + 1) { n: -(i + 1) });
        }
        emit(new PingEvent(0) { n: -2000 });
    }
}

handler PingHandler extends Handler {
    onEvent(e: PingEvent) {
        if (e.n > 0) {
            var vo = Model.get(ItemVo, oid);
            if (vo == null) {
                vo = new ItemVo();
                vo.n = e.n;
                Model.set(vo);
            } else {
                vo.n = e.n;
                Model.set(vo);
            }
        } else {
            var old = Model.get(ItemVo, oid);
            if (old != null) {
                Model.remove(ItemVo, oid);
            }
            if (e.n == -2000) {
                if (oid == 0) {
                    print("bad");
                } else {
                    print("done");
                }
            }
        }
    }
}

entry MainController;
