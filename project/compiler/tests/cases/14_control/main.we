module demo.control;

controller MainController {
    run() {
        var i: int = 0;
        while (i < 5) {
            i = i + 1;
            if (i == 3) {
                continue;
            }
            if (i == 4) {
                break;
            }
            print("i =", i);
        }
        print("done");
    }
}

entry MainController;
