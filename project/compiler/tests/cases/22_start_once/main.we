module demo.startonce;

event PingEvent extends Event {
    n: int;
}

controller ChildController {
    run() {
        print("child started");
        on(PingEvent, ChildHandler);
    }
}

controller MainController {
    run() {
        start(ChildController);
        start(ChildController);
        on(PingEvent, MainHandler);
        emit(new PingEvent(1) { n: 1 });
        print("main done");
    }
}

handler ChildHandler {
    onEvent(e: PingEvent) {
        print("child ", e.n);
    }
}

handler MainHandler {
    onEvent(e: PingEvent) {
        print("main ", e.n);
    }
}

entry MainController;
