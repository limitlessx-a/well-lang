module demo.ctxreplace;

struct Temp extends Vo {
    n: int;
}

event PingEvent extends Event {
}

controller MainController {
    run() {
        on(PingEvent, PingHandler);
        emit(new PingEvent());
    }
}

handler PingHandler {
    onEvent(e: PingEvent) {
        var vo = new Temp();
        vo = new Temp();
        vo = new Temp();
        print("replace ok");
    }
}

entry MainController;
