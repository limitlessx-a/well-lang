module demo.modelfacade;

struct ItemVo extends Vo {
    v: int;
}

controller MainController {
    run() {
        var a = new ItemVo() { v: 7 };
        Model.set(a);

        var b = Model.findByOid(ItemVo, 0);
        print(b.v);

        Model.remove(ItemVo, 0);
        var c = Model.findByOid(ItemVo, 0);
        print(c == null);
    }
}

entry MainController;
