module demo.stop;

event PingEvent extends Event {
    n: int;
}

controller ChildController {
    run() {
        print("child start");
        on(PingEvent, PingHandler);
    }
}

controller MainController {
    run() {
        start(ChildController);
        emit(new PingEvent(1) { n: 1 });
        stop(ChildController);
        start(ChildController);
        emit(new PingEvent(2) { n: 2 });
    }
}

handler PingHandler {
    onEvent(e: PingEvent) {
        print("h ", e.n);
    }
}

entry MainController;
