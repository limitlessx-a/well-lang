module demo.foreign;

struct ItemVo extends Vo {
    value: int;
}

event MakeEvent extends Event {
}

event ReadEvent extends Event {
    item: ItemVo;
}

controller MainController {
    run() {
        on(MakeEvent, MakeHandler);
        on(ReadEvent, ReadHandler);
        emit(new MakeEvent(1));
    }
}

handler MakeHandler {
    onEvent(e: MakeEvent) {
        var item: ItemVo = new ItemVo();
        item.value = 100;
        Model.set(item);
        emit(new ReadEvent(2) { item: item });
    }
}

handler ReadHandler {
    onEvent(e: ReadEvent) {
        print("foreign value:", e.item.value);
    }
}

entry MainController;
