module bench.jsonlong;

struct LongBlob {
    text: String;
    n: int;
}

controller LongJsonBench {
    run() {
        var text: String = "{\"text\":\"\",\"n\":1}";
        var iters: long = 100000;
        var acc: long = 0;
        for (var w: int = 0; w < 1000; w = w + 1) {
            var b: LongBlob = Json.parse(LongBlob, text);
            acc = acc + b.text.length;
        }
        var t0: long = Host.nowMs();
        for (var i: long = 0; i < iters; i = i + 1) {
            var b: LongBlob = Json.parse(LongBlob, text);
            acc = acc + b.text.length + b.n;
        }
        var elapsed: long = Host.nowMs() - t0;
        print("parse_ns ", elapsed * 1000000 / iters);
        print("checksum ", acc);
    }
}

entry LongJsonBench;
