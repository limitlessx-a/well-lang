module bench.literals;

// String-literal lookup microbenchmark.  Every `"..."` expression in generated
// C calls well_string_lit(); the runtime used to find an interned literal with a
// linear scan over every distinct literal in the program.  This program has 65
// literals, so a lookup that scans half the table is visible in the loop below.
func pick(i: long): String {
    if (i == 0) { return "lit_00"; }
    if (i == 1) { return "lit_01"; }
    if (i == 2) { return "lit_02"; }
    if (i == 3) { return "lit_03"; }
    if (i == 4) { return "lit_04"; }
    if (i == 5) { return "lit_05"; }
    if (i == 6) { return "lit_06"; }
    if (i == 7) { return "lit_07"; }
    if (i == 8) { return "lit_08"; }
    if (i == 9) { return "lit_09"; }
    if (i == 10) { return "lit_10"; }
    if (i == 11) { return "lit_11"; }
    if (i == 12) { return "lit_12"; }
    if (i == 13) { return "lit_13"; }
    if (i == 14) { return "lit_14"; }
    if (i == 15) { return "lit_15"; }
    if (i == 16) { return "lit_16"; }
    if (i == 17) { return "lit_17"; }
    if (i == 18) { return "lit_18"; }
    if (i == 19) { return "lit_19"; }
    if (i == 20) { return "lit_20"; }
    if (i == 21) { return "lit_21"; }
    if (i == 22) { return "lit_22"; }
    if (i == 23) { return "lit_23"; }
    if (i == 24) { return "lit_24"; }
    if (i == 25) { return "lit_25"; }
    if (i == 26) { return "lit_26"; }
    if (i == 27) { return "lit_27"; }
    if (i == 28) { return "lit_28"; }
    if (i == 29) { return "lit_29"; }
    if (i == 30) { return "lit_30"; }
    if (i == 31) { return "lit_31"; }
    if (i == 32) { return "lit_32"; }
    if (i == 33) { return "lit_33"; }
    if (i == 34) { return "lit_34"; }
    if (i == 35) { return "lit_35"; }
    if (i == 36) { return "lit_36"; }
    if (i == 37) { return "lit_37"; }
    if (i == 38) { return "lit_38"; }
    if (i == 39) { return "lit_39"; }
    if (i == 40) { return "lit_40"; }
    if (i == 41) { return "lit_41"; }
    if (i == 42) { return "lit_42"; }
    if (i == 43) { return "lit_43"; }
    if (i == 44) { return "lit_44"; }
    if (i == 45) { return "lit_45"; }
    if (i == 46) { return "lit_46"; }
    if (i == 47) { return "lit_47"; }
    if (i == 48) { return "lit_48"; }
    if (i == 49) { return "lit_49"; }
    if (i == 50) { return "lit_50"; }
    if (i == 51) { return "lit_51"; }
    if (i == 52) { return "lit_52"; }
    if (i == 53) { return "lit_53"; }
    if (i == 54) { return "lit_54"; }
    if (i == 55) { return "lit_55"; }
    if (i == 56) { return "lit_56"; }
    if (i == 57) { return "lit_57"; }
    if (i == 58) { return "lit_58"; }
    if (i == 59) { return "lit_59"; }
    if (i == 60) { return "lit_60"; }
    if (i == 61) { return "lit_61"; }
    if (i == 62) { return "lit_62"; }
    if (i == 63) { return "lit_63"; }
    return "lit_64";
}

controller LiteralBench {
    run() {
        var iters: long = 4000000;
        var acc: long = 0;
        for (var w: int = 0; w < 20000; w = w + 1) {
            var s: String = pick(w % 65);
            acc = acc + s.length;
        }
        var t0: long = Host.nowMs();
        for (var i: long = 0; i < iters; i = i + 1) {
            // "lit_64" is interned last, so the linear-scan implementation had
            // to strcmp every one of the 65 literals on each evaluation.
            var s: String = "lit_64";
            acc = acc + s.length;
        }
        var elapsed: long = Host.nowMs() - t0;
        print("iters ", iters);
        print("total_ms ", elapsed);
        print("ns_per_lookup ", elapsed * 1000000 / iters);
        print("checksum ", acc);
    }
}

entry LiteralBench;
