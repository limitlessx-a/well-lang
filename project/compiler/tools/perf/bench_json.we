module bench.json;

// JSON parse/stringify microbenchmark: a 150-byte object with one nested struct
// and a string array.  Parse and stringify are measured separately.
struct JAddr {
    city: String;
    zip: int;
}

struct JUser {
    id: long;
    name: String;
    age: int;
    tags: Array<String>;
    addr: JAddr;
}

controller JsonBench {
    run() {
        var text: String = "{\"id\":123,\"name\":\"alice\",\"age\":30,\"tags\":[\"a\",\"b\",\"c\"],\"addr\":{\"city\":\"NY\",\"zip\":10001}}";
        var iters: long = 300000;
        var warm: long = 0;
        var acc: long = 0;
        for (var w: int = 0; w < 2000; w = w + 1) {
            var u: JUser = Json.parse(JUser, text);
            warm = warm + u.id + u.tags.length;
        }
        var t0: long = Host.nowMs();
        for (var i: long = 0; i < iters; i = i + 1) {
            var u: JUser = Json.parse(JUser, text);
            acc = acc + u.id + u.name.length + u.tags.length + u.addr.zip;
        }
        var t1: long = Host.nowMs();
        var one: JUser = Json.parse(JUser, text);
        for (var j: long = 0; j < iters; j = j + 1) {
            var s: String = Json.stringify(one, 0);
            acc = acc + s.length;
        }
        var t2: long = Host.nowMs();
        print("iters ", iters);
        print("parse_ms ", t1 - t0);
        print("stringify_ms ", t2 - t1);
        print("parse_ns ", (t1 - t0) * 1000000 / iters);
        print("stringify_ns ", (t2 - t1) * 1000000 / iters);
        print("checksum ", acc + warm);
    }
}

entry JsonBench;
