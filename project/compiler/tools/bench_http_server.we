// Benchmark HTTP server template. tools/bench.py substitutes {{PORT}} before
// building; do not build this file directly.
module bench.httpserver;

event HttpRequestEvent extends Event {
    reqId: long;
    method: String;
    path: String;
    query: String;
    body: String;
}

controller BenchController {
    run() {
        Http.route("/bench", "GET", BenchHandler);
        Http.listen({{PORT}});
    }
}

handler BenchHandler {
    onEvent(e: HttpRequestEvent) {
        Http.respond(e.reqId, 200, "ok");
    }
}

entry BenchController;
