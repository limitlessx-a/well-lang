module bench.heamaplit;

struct Holder {
    m: Map<int>;
}

controller HeapMapLitBench {
    run() {
        var n: long = 1000000;
        var acc: long = 0;
        var h: Holder = new Holder();
        var t0: long = Host.nowMs();
        for (var i: long = 0; i < n; i = i + 1) {
            var m: Map<int> = {"a": 1, "b": 2};
            h.m = m;
            acc = acc + h.m["a"] + h.m["b"];
        }
        var ms: long = Host.nowMs() - t0;
        print("well-heamaplit n=", n, " ms=", ms, " ns_per_op=", ms * 1000000 / n,
              " acc=", acc);
    }
}

entry HeapMapLitBench;
