module bench.heaplit2;

struct Holder {
    a: Array<int>;
}

controller HeapLit2Bench {
    run() {
        var n: long = 1000000;
        var acc: long = 0;
        var h: Holder = new Holder();
        var t0: long = Host.nowMs();
        for (var i: long = 0; i < n; i = i + 1) {
            var a: Array<int> = [1, 2, 3];
            h.a = a;
            acc = acc + h.a[0] + h.a[1] + h.a[2];
        }
        var ms: long = Host.nowMs() - t0;
        print("well-heapllit2 n=", n, " ms=", ms, " ns_per_op=", ms * 1000000 / n,
              " acc=", acc);
    }
}

entry HeapLit2Bench;
