module bench.loop;

controller LoopBench {
    run() {
        var n: long = 100000000;
        var acc: long = 0;
        var t0: long = Host.nowMs();
        for (var i: long = 0; i < n; i = i + 1) {
            acc = acc + i;
        }
        var ms: long = Host.nowMs() - t0;
        print("well n=", n, " ms=", ms, " ns_per_iter=", ms * 1000000 / n,
              " acc=", acc);
    }
}

entry LoopBench;
