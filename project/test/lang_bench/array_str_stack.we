module bench.arrstr;

controller ArrStrBench {
    run() {
        var n: long = 2000000;
        var acc: long = 0;
        var t0: long = Host.nowMs();
        for (var i: long = 0; i < n; i = i + 1) {
            var a: Array<String> = ["a", "bb"];
            acc = acc + a[0].length + a[1].length;
        }
        var ms: long = Host.nowMs() - t0;
        print("well-arrstr n=", n, " ms=", ms, " ns_per_op=", ms * 1000000 / n,
              " acc=", acc);
    }
}

entry ArrStrBench;
