module bench.hearefmap;

struct Item {
    n: int;
}

struct Holder {
    m: Map<Item>;
}

controller HeapRefMapBench {
    run() {
        var n: long = 1000000;
        var acc: long = 0;
        var h: Holder = new Holder();
        var t0: long = Host.nowMs();
        for (var i: long = 0; i < n; i = i + 1) {
            var m: Map<Item> = {"a": new Item(), "b": new Item()};
            h.m = m;
            acc = acc + h.m["a"].n + h.m["b"].n;
        }
        var ms: long = Host.nowMs() - t0;
        print("well-hearefmap n=", n, " ms=", ms, " ns_per_op=", ms * 1000000 / n,
              " acc=", acc);
    }
}

entry HeapRefMapBench;
