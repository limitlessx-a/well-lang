{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*|[0-9]+",
  "indentationRules": {
    "increaseIndentPattern": "^.*\\{[^}\"']*$",
    "decreaseIndentPattern": "^[ \\t]*[}\\)]"
  },
  "onEnterRules": [
    {
      "beforeText": "^[ \\t]*\\{[ \\t]*$",
      "afterText": "^[ \\t]*\\}[ \\t]*$",
      "action": { "indent": "indentOutdent" }
    },
    {
      "beforeText": "^.*\\{[^}\"']*$",
      "afterText": "^[ \\t]*[^ \\t}]",
      "action": { "indent": "indent" }
    },
    {
      "beforeText": "^[ \\t]*\\}[ \\t]*$",
      "action": { "indent": "outdent" }
    }
  ],
  "folding": {
    "markers": {
      "start": "^[ \\t]*//[ \\t]*#?region\\b",
      "end": "^[ \\t]*//[ \\t]*#?endregion\\b"
    }
  }
}
